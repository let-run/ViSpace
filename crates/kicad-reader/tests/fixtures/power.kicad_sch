(kicad_sch (version 20250114) (generator "inventory_reader_test") (uuid "power") (paper "A4")
 (title_block (title "Power stage"))
 (lib_symbols (symbol "Device:C"
  (pin_names (offset 0) (hide yes))
  (symbol "C_0_1" (polyline (pts (xy -2 0.5) (xy 2 0.5)) (stroke (width 0.2))) (polyline (pts (xy -2 -0.5) (xy 2 -0.5)) (stroke (width 0.2))))
  (symbol "C_1_1" (pin passive line (at 0 3 270) (length 2.5) (name "~") (number "1")) (pin passive line (at 0 -3 90) (length 2.5) (name "~") (number "2")))
 ))
 (symbol (lib_id "Device:C") (at 50 40 0) (unit 1) (uuid "capacitor")
  (property "Reference" "C1" (at 55 39 0) (effects (font (size 1.27 1.27)) (justify left)))
  (property "Value" "100nF" (at 55 42 0) (effects (font (size 1.27 1.27)) (justify left)))
  (instances (project "demo" (path "/root/sheet-a" (reference "C101") (unit 1)) (path "/root/sheet-b" (reference "C201") (unit 1)))))
 (wire (pts (xy 40 25) (xy 50 25) (xy 50 37)) (stroke (width 0.15)))
 (wire (pts (xy 50 43) (xy 50 55) (xy 40 55)) (stroke (width 0.15)))
 (label "${SUPPLY}" (at 40 25 0) (effects (font (size 1.27 1.27)) (justify left bottom)))
 (label "GND" (at 40 55 0) (effects (font (size 1.27 1.27)) (justify left bottom)))
)
